# ============================================================================
# EcoInsight Backend — Environment Configuration
# ============================================================================
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================================

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecoinsight
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=ecoinsight_jwt_secret_change_in_production_2026
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173
